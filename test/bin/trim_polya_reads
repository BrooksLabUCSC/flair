#!/usr/bin/env python3
"""
Trim poly(A) tails from the 3' end and poly(T) heads from the 5' end of
reads in a FASTA file.  Used to make test reads that have no poly(A)
evidence for single-exon strand correction.

Detection mirrors flair.isoform_data._check_polyA: a rolling window that
extends while it is at least POLYA_MIN_FRAC A (or T), then backs up to the
last A (or T), and then to a run of POLY_EDGE_RUN A's (or T's).  Runs shorter
than POLYA_MIN_LEN are left alone, as flair does not detect them.
"""
import sys
import argparse

POLYA_MIN_FRAC = 0.6
POLYA_SEARCH_WINDOW = 5
POLYA_MIN_LEN = 10
POLY_EDGE_RUN = 3  # the trimmed run must start on this many consecutive poly bases

def parse_args():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('in_fasta', help='input reads FASTA')
    parser.add_argument('out_fasta', help='output reads FASTA with poly(A) removed')
    return parser.parse_args()

def poly_run_len(end_seq, base):
    """length of the poly-base run at the start of end_seq, 0 if none"""
    if len(end_seq) < POLYA_SEARCH_WINDOW:
        return 0
    i = POLYA_SEARCH_WINDOW
    if end_seq[:i].count(base) / POLYA_SEARCH_WINDOW < POLYA_MIN_FRAC:
        return 0
    while i < len(end_seq) and end_seq[i - POLYA_SEARCH_WINDOW + 1:i + 1].count(base) / POLYA_SEARCH_WINDOW >= POLYA_MIN_FRAC:
        i += 1
    j = end_seq[:i].rfind(base) + 1
    # the window tolerates a few non-poly bases at the inner edge of the run;
    # give those back so the trim does not remove transcript sequence
    while j > 0 and end_seq[max(j - POLY_EDGE_RUN, 0):j] != base * min(POLY_EDGE_RUN, j):
        j -= 1
    return j if j >= POLYA_MIN_LEN else 0

def trim_poly(seq):
    upper = seq.upper()
    tail = poly_run_len(upper[::-1], 'A')
    if tail > 0:
        seq, upper = seq[:-tail], upper[:-tail]
    head = poly_run_len(upper, 'T')
    return seq[head:]

def read_fasta(fh):
    name, seq = None, []
    for line in fh:
        line = line.rstrip('\n')
        if line.startswith('>'):
            if name is not None:
                yield name, ''.join(seq)
            name, seq = line[1:], []
        else:
            seq.append(line)
    if name is not None:
        yield name, ''.join(seq)

def main():
    args = parse_args()
    num_reads = num_trimmed = 0
    with open(args.in_fasta) as in_fh, open(args.out_fasta, 'w') as out_fh:
        for name, seq in read_fasta(in_fh):
            trimmed = trim_poly(seq)
            num_reads += 1
            if len(trimmed) != len(seq):
                num_trimmed += 1
            out_fh.write(f'>{name}\n{trimmed}\n')
    print(f'{args.in_fasta}: trimmed {num_trimmed} of {num_reads} reads', file=sys.stderr)

if __name__ == '__main__':
    main()
