usage: quantify [-h] --manifest MANIFEST --genome GENOME [-o OUTPUT]
                [-t THREADS] [--sample_id_only] [--tpm] [--quality QUALITY]
                [--trust_ends] [--generate_map] --isoform_bed ISOFORM_BED
                [--with_gene] [--norm_ends]

options:
  -h, --help            show this help message and exit
  -o OUTPUT, --output OUTPUT
                        output file name base for FLAIR quantify (default:
                        flair.quantify)
  -t THREADS, --threads THREADS
                        minimap2 number of threads (4)
  --sample_id_only      only use sample id in output header
  --tpm                 Convert counts matrix to transcripts per million and
                        output as a separate file named <output>.tpm.tsv
  --quality QUALITY     minimum MAPQ of read assignment to an isoform (0)
  --trust_ends          specify if reads are generated from a long read method
                        with minimal fragmentation
  --generate_map        create read-to-isoform assignment files for each
                        sample (default: not specified)
  --with_gene           output lines with have isoform_gene
  --norm_ends           normalize transcript ends (recommended if not using
                        trust_ends and don't care about different transcript
                        ends)

required named arguments:
  --manifest MANIFEST   Tab delimited file containing sample id, condition,
                        batch, and the path to that sample's reads aligned to
                        the genome as a sorted, indexed BAM
  --genome GENOME       FastA of genome
  --isoform_bed ISOFORM_BED
                        isoform .bed file
