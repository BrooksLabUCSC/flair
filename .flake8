[flake8]
# E302: expected 2 blank lines
# E741: ambiguous variable name
# F523: .format unused named arguments
# F524: .format missing named arguments
# W503: line break before binary operator (PEP 8 preferred style)
# W504: line break after binary operator
ignore = E302,E741,F523,F524,W503,W504
max-complexity = 10
max-line-length = 256
# pycbio is a copy of an external library, checked by the pycbio-flake8 target
# with its own configuration.  Others are editor backups or generated output.
extend-exclude = src/flair/pycbio,.claude.bak,.emacs.bak,.ropeproject,docs/build,pip_test_env,test/output,test/tmp-input,test/seg-work
