#! /usr/bin/env python3
"""Generate the command line documentation from the flair parsers.

Writes one RST file per flair subcommand and per installed script, each holding
the usage line and the options exactly as argparse knows them.  The files are
committed, and the prose pages in docs/source include them, so the documentation
build needs none of FLAIR's runtime dependencies.  Run `make doc-cli' after
changing any option.

The list of scripts comes from [project.scripts] in pyproject.toml, so a new
script is documented as soon as it is installed.  Every script must provide a
build_parser() returning its ArgumentParser.
"""
import argparse
import importlib
import os
import sys
import tomllib

# deterministic wrapping of the usage line, independent of the terminal
os.environ['COLUMNS'] = '80'

ROOT_DIR = os.path.join(os.path.dirname(os.path.realpath(__file__)), "../..")
sys.path.insert(0, os.path.join(ROOT_DIR, "src"))

from flair import flair_cli  # noqa: E402

GENERATED_BY = "dev/bin/flair-gen-cli-doc"

# the flair command is documented as its subcommands, not as one page
FLAIR_COMMAND = 'flair'

def parse_args():
    desc = "generate the FLAIR command line documentation from the argparse parsers"
    parser = argparse.ArgumentParser(description=desc)
    parser.add_argument('outdir',
                        help="directory to write the per-subcommand RST files into")
    return parser.parse_args()

def get_subparsers(parser):
    "the subcommand name to parser map, in the order the subcommands were added"
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            return action.choices
    raise Exception(f"no subparsers found in parser for `{parser.prog}'")

def is_documented(action):
    "the help action and the hidden global option traps are not part of the interface"
    return (action.help is not argparse.SUPPRESS) and not isinstance(action, argparse._HelpAction)

def format_invocation(formatter, action):
    "`-r READS, --reads READS', as the terminal help writes it"
    return formatter._format_action_invocation(action)

def format_help(formatter, action):
    "the help text with %(default)s and friends expanded"
    return ' '.join(formatter._expand_help(action).split())

def write_option(fh, formatter, action):
    fh.write(f".. option:: {format_invocation(formatter, action)}\n\n")
    fh.write(f"   {format_help(formatter, action)}\n\n")

def write_group(fh, formatter, group):
    actions = [a for a in group._group_actions if is_documented(a)]
    if actions:
        fh.write(f".. rubric:: {group.title}\n\n")
        for action in actions:
            write_option(fh, formatter, action)

def write_usage(fh, parser):
    fh.write(".. code-block:: text\n\n")
    for line in parser.format_usage().rstrip().split('\n'):
        fh.write(f"   {line}\n" if line else "\n")
    fh.write("\n")

def write_subcommand(fh, parser):
    fh.write(f".. Generated by {GENERATED_BY}; edit the argparse options, not this file.\n\n")
    fh.write(f".. program:: {parser.prog}\n\n")
    write_usage(fh, parser)
    formatter = parser._get_formatter()
    for group in parser._action_groups:
        write_group(fh, formatter, group)

def gen_subcommand_doc(outdir, name, parser):
    path = os.path.join(outdir, name + '.rst')
    with open(path, 'w') as fh:
        write_subcommand(fh, parser)
    return path

def get_script_entry_points():
    "command name to `module:function' from [project.scripts], minus flair itself"
    with open(os.path.join(ROOT_DIR, "pyproject.toml"), 'rb') as fh:
        scripts = tomllib.load(fh)['project']['scripts']
    return {name: entry for name, entry in scripts.items() if name != FLAIR_COMMAND}

def get_script_parser(command, entry_point):
    module = importlib.import_module(entry_point.split(':')[0])
    build_parser = getattr(module, 'build_parser', None)
    if build_parser is None:
        raise Exception(f"{entry_point.split(':')[0]} has no build_parser(), so the command "
                        f"`{command}' cannot be documented; split its parser out of main()")
    return build_parser()

def gen_subcommands_doc(outdir):
    subparsers = get_subparsers(flair_cli.build_parser())
    for name, parser in subparsers.items():
        print(gen_subcommand_doc(outdir, name, parser))

def gen_scripts_doc(outdir):
    for command, entry_point in get_script_entry_points().items():
        print(gen_subcommand_doc(outdir, command, get_script_parser(command, entry_point)))

def gen_cli_doc(outdir):
    os.makedirs(outdir, exist_ok=True)
    gen_subcommands_doc(outdir)
    gen_scripts_doc(outdir)

def main():
    args = parse_args()
    gen_cli_doc(args.outdir)


main()
